# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-vercel-app.vercel.app
TRUST_PROXY_HOPS=1

# API Configuration
VITE_API_URL=https://your-render-service.onrender.com

# Database Configuration (PostgreSQL / Supabase)
# Use the Transaction Pooler connection string from Supabase → Settings → Database
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Security & Authentication
ADMIN_TOKEN=replace-with-a-strong-random-string
DEFAULT_STAFF_PASSWORD=replace-with-a-temporary-password

# Email Service (Resend)
RESEND_API_KEY=re_replace_with_your_key
